{
  "schemaVersion": 1,
  "id": "omassistant",
  "name": "Omassistant",
  "version": "0.9.6",
  "author": "Tom-Erik",
  "description": "A permissioned, screen-aware assistant for the Omarchy desktop.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Omassistant.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
